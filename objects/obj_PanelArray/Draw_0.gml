if(global.targetPanel==id)
{
	draw_sprite_ext(spr_WireFrameGrid1,image_index,x,y,1,1,0,c_green,1)
}

else{
	if(entity!=undefined)
	{
		if(entity==global.activeCombatant)
		{
			draw_sprite_ext(spr_WireFrameGrid1,image_index,x,y,1,1,0,c_aqua,1)
		}
		else{
			draw_sprite_ext(spr_WireFrameGrid1,image_index,x,y,1,1,0,c_red,1)
		}
	}
	else{
			draw_self()
		}
}